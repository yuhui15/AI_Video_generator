# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Generated video assets and intermediate files
output/
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.png
*.jpg
*.jpeg

# Keep project-provided, licensed background music trackable
!music/
!music/*.mp3

# Keep user-provided, licensed I2V input images trackable
!input_images/
!input_images/*.jpg
!input_images/*.jpeg
!input_images/*.png
!input_images/*.webp

# Local tooling and OS files
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db
